<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProtoFast.Auth.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Api transitively brings ServiceDefaults (the internal-JWT validator) too. -->
    <ProjectReference Include="..\..\src\ProtoFast.Auth.Api\ProtoFast.Auth.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real dev tenant map, so TenantResolverTests binds the file we actually ship rather
         than a copy of it that can drift. -->
    <None Include="..\..\src\ProtoFast.Auth.Api\appsettings.Development.json"
          Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
