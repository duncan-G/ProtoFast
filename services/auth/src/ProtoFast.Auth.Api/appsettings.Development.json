{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "ClientSecretProtofastWeb": "dev-protofast-web-secret",
    "ClientSecretAdmin": "dev-admin-secret",
    "AdminClientSecret": "dev-account-admin-secret"
  },
  "Smtp": {
    // Fallback when auth-svc is not launched from the AppHost. Under Aspire, Program.cs
    // injects Auth_Smtp__Host/Port from smtp4dev's published SMTP endpoint (not 1025).
    "Host": "localhost",
    "Port": 1025,
    "StartTls": false,
    "From": "no-reply@protofast.dev"
  },
  "InternalJwt": {
    "KeyId": "dev-1"
  },
  "Tenants": {
    "ByHost": {
      "localhost": {
        "Realm": "protofast",
        "ClientId": "protofast-web"
      }
    }
  }
}
