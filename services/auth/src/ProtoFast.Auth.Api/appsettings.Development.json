{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Smtp": {
    // Fallback when auth-svc is not launched from the AppHost. Under Aspire, Program.cs
    // injects Auth_Smtp__Host/Port from smtp4dev's published SMTP endpoint (not 1025).
    "Host": "localhost",
    "Port": 1025,
    "StartTls": false,
    "From": "no-reply@protofast.dev"
  },
  "Secrets": {
    "SecretId": "protofast/dev"
  },
  // In dev every client answers on localhost, so the PORT is the only thing separating them:
  // 20000 admin, 20001 protofast, 20002 theplot (apphost/Program.cs). The resolver prefers an
  // entry naming the port and falls back to the bare name, so the portless "localhost" below
  // stays the default for anything not listed. Production hosts carry no port and need none.
  "Tenants": {
    "ByHost": {
      "localhost": {
        "Realm": "protofast",
        "ClientId": "protofast-web"
      },
      // The key is a plain label, not the host: configuration keys split on ":", so
      // "localhost:20002" would bind as a nested section and this entry would vanish.
      "theplot-dev": {
        "Host": "localhost:20002",
        "Realm": "theplot",
        "ClientId": "theplot-web"
      }
    }
  }
}
