{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Smtp": {
    // Fallback when auth-svc is not launched from the AppHost. Under Aspire, Program.cs
    // injects Auth_Smtp__Host/Port from smtp4dev's published SMTP endpoint (not 1025).
    "Host": "localhost",
    "Port": 1025,
    "StartTls": false,
    "From": "no-reply@protofast.dev"
  },
  "Secrets": {
    "SecretId": "protofast/dev"
  },
  "Tenants": {
    "ByHost": {
      "localhost": {
        "Realm": "protofast",
        "ClientId": "protofast-web"
      },
      // The theplot Envoy listener. Dev listeners share localhost and differ only by port
      // (20000 admin, 20001 protofast, 20002 theplot — WithClient registration order), so
      // the port is what puts this one in its own realm; TenantResolver matches host:port
      // entries before falling back to the bare host. '+' stands in for ':' — a colon in
      // a config key is a path separator and would silently break the binding.
      "localhost+20002": {
        "Realm": "theplot",
        "ClientId": "theplot-web"
      }
    }
  }
}
