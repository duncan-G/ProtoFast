{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Keyed by the spec's host names: each account's hostname for one arrives as HOST_<NAME>
  // (TenantResolver), so these are the same in every environment.
  "Tenants": {
    "ByHost": {
      "protofast": {
        "Realm": "protofast",
        "ClientId": "protofast-web"
      },
      "theplot": {
        "Realm": "theplot",
        "ClientId": "theplot-web"
      },
      // The admin host signs operators in to the operators realm and issues a session only to
      // an account holding a console role (docs/design/admin-consoles.md). max_age forces a
      // re-authentication on entering the console; AcrValues stays empty until operator passkey
      // coverage and the break-glass procedure are both in place.
      "admin": {
        "Realm": "operators",
        "ClientId": "admin",
        "RequiredRoles": [ "platform", "admin-protofast", "admin-theplot" ],
        "MaxAge": 900,
        "Consoles": {
          "theplot": "admin-theplot"
        }
      }
    }
  }
}
