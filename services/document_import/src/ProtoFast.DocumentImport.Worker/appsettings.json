{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Secrets": {
    "SecretId": "protofast/app",
    "Prefix": "Api_"
  },
  "S3": {
    "Bucket": "protofast-document-upload"
  },
  "Sqs": {
    "DocumentImport": {
      "QueueName": "protofast-document-upload"
    },
    "WorkflowOutcomes": {
      "QueueName": "protofast-workflow-outcomes.fifo"
    },
    "WorldModelBuild": {
      "QueueName": "protofast-world-model-build"
    }
  },
  "Providers": {
    "Default": "deepseek",
    "Fallback": "gemini"
  },
  "Consumer": {
    "MaxConcurrentImports": 2
  },
  "DiscoveryAgent": {
    "ModelClass": "large"
  },
  "WorldModel": {
    "ModelClass": "medium",
    "MaxConcurrentBuilds": 1,
    "LocationConcurrency": 3
  },
  "Conversion": {
    "BaseUrl": null
  }
}
