{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Secrets": {
    "SecretId": "protofast/app",
    "Prefix": "Api_"
  },
  "S3": {
    "Bucket": "protofast-document-upload",
    "UploadUrlTtl": "00:05:00",
    "DownloadUrlTtl": "00:05:00"
  }
}
