{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Secrets": {
    "SecretId": "protofast/app",
    "Prefix": "Api_"
  },
    "S3": {
        "Bucket": "api",
        "MaxUploadBytes": 67108864,
        "UploadUrlTtl": "00:5:00",
        "DownloadUrlTtl": "00:5:00"
    }
}
