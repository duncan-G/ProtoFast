{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Secrets": {
    "SecretId": "protofast/app",
    "Prefix": "Api_"
  },
  "S3": {
    "Bucket": "protofast-document-upload",
    "UploadUrlTtl": "00:05:00",
    "DownloadUrlTtl": "00:05:00"
  },
  "Sqs": {
    "DocumentImport": {
      "QueueName": "protofast-document-upload"
    }
  },
  "Providers": {
    "Default": "deepseek",
    "Retry": {
      "MaxWait": "00:00:30"
    }
  },
  "Director": {
    "ModelClass": "medium"
  },
  "Speech": {
    "ElevenLabs": {
      "Model": "eleven_v4",
      "OutputFormat": "mp3_44100_128"
    }
  },
  "Imaging": {
    "Muse": {
      "Model": "muse-image-1.0",
      "OutputFormat": "webp"
    }
  }
}
