{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // gRPC over cleartext HTTP/2, which ProtoStrap's edge speaks to a grpc service.
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "S3": {
    "UploadUrlTtl": "00:05:00",
    "DownloadUrlTtl": "00:05:00"
  }
}
