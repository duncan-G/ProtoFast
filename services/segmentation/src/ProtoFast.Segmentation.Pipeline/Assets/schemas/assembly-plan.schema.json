{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["outline", "followUps", "gaps"],
  "additionalProperties": false,
  "properties": {
    "outline": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "followUps": {
      "type": "array",
      "items": { "$ref": "#/$defs/followUp" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["depth", "sources", "title"],
      "additionalProperties": false,
      "properties": {
        "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^W\\d{5}:n\\d+$" }
        },
        "title": { "type": "string", "maxLength": 200 }
      }
    },
    "followUp": {
      "type": "object",
      "required": ["kind", "node", "relatedNode"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["continues_previous", "title_source", "boundary_check", "depth_check"] },
        "node": { "type": "string", "pattern": "^W\\d{5}:n\\d+$" },
        "relatedNode": { "type": "string" }
      }
    },
    "gap": {
      "type": "object",
      "required": ["kind", "evidence", "observation", "proposal"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["deterministic", "agent", "prompt"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^W\\d{5}:n\\d+$" }
        },
        "observation": { "type": "string", "maxLength": 500 },
        "proposal": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
