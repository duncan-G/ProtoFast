{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ProtoFast.Segmentation": "Debug"
    }
  },
  "Secrets": {
    "SecretId": "protofast/dev"
  },
  "Storage": {
    // LocalStack does not implement object lock, so freezing writes the artifact and its hash but
    // no storage-level retention. The difference is logged rather than silently tolerated.
    "ObjectLockEnabled": false
  },
  "Queues": {
    // Matched to the deployed value so local throughput behaves like production's. A run is
    // almost pure provider wait, so eight of them cost a local machine very little.
    "MaxConcurrentRuns": 8
  }
}
