    # Keycloak edge vhost (prod publish only). Dedicated domain; allowlist of the
    # browser login/logout surface. Admin, account console, JWKS, and master stay
    # on the private network — anything not listed below 404s and never reaches Keycloak.
    #
    # Regexes match :path INCLUDING the query string (unlike prefix/path), so the
    # exact-path rules end with (\?.*)?. Keep each one small: Envoy rejects an RDS
    # update whose RE2 program size exceeds 100, and a rejected update leaves this
    # vhost with no routes at all.
    #
    # x-forwarded-proto is re-asserted because the listener's scheme_header_transformation
    # (scheme_to_overwrite: http, for the cleartext gRPC upstreams) also rewrites XFP
    # to http. Keycloak then sees a plaintext request and sslRequired=external returns
    # error=ssl_required. TLS always terminates at this listener, so https is truthful here.
    - name: keycloak
      domains: ["__KEYCLOAK_DOMAIN__"]
      # Keycloak resolves its own SSO cookie. Skipping ext_authz avoids a round trip
      # on the login path for headers it would ignore.
      typed_per_filter_config:
        envoy.filters.http.ext_authz:
          "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
          disabled: true
      request_headers_to_add:
        - header: { key: "x-forwarded-proto", value: "https" }
          append_action: OVERWRITE_IF_EXISTS_OR_ADD
      routes:
        # Login is GET/POST (and HEAD/OPTIONS). Anything else 405s so a later path
        # widening still cannot PUT/DELETE the admin API.
        - match:
            prefix: "/"
            headers:
              - name: ":method"
                string_match:
                  safe_regex:
                    regex: "GET|HEAD|POST|OPTIONS"
                invert_match: true
          direct_response:
            status: 405
            body: { inline_string: "Method Not Allowed\n" }

        # Master holds the bootstrap admin. Denied before the allow rules so the
        # realm-agnostic [^/?]+ below cannot serve its login form.
        - match: { prefix: "/realms/master" }
          direct_response: &keycloak_denied
            status: 404
            body: { inline_string: "Not Found\n" }

        # --- allowed: interactive sign-in ---
        - match:
            safe_regex:
              regex: "^/realms/[^/?]+/protocol/openid-connect/auth(\\?.*)?$"
          route: &keycloak_route
            cluster: keycloak
            timeout: 0s
        - match:
            safe_regex:
              regex: "^/realms/[^/?]+/protocol/openid-connect/logout(\\?.*)?$"
          route: *keycloak_route
        - match:
            safe_regex:
              regex: "^/realms/[^/?]+/login-actions/.*"
          route: *keycloak_route
        # Social IdP start + callback. Providers are off in the realm import today;
        # the routes exist so enabling one in admin is the only extra step.
        - match:
            safe_regex:
              regex: "^/realms/[^/?]+/broker/[^/?]+/(login|endpoint).*"
          route: *keycloak_route
        - match: { prefix: "/resources/" }
          route: *keycloak_route

        # 404, not 403: a distinct "blocked" status maps the surface for probes.
        # Add a rule above (never a hole here) if a browser-facing endpoint is needed.
        - match: { prefix: "/" }
          direct_response: *keycloak_denied
